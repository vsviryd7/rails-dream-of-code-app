<div id="<%= dom_id student %>">
  <p>
    <strong>First name:</strong>
    <%= student.first_name %>
  </p>

  <p>
    <strong>Last name:</strong>
    <%= student.last_name %>
  </p>

  <p>
    <strong>Email:</strong>
    <%= student.email %>
  </p>
  
  <% if session[:role] == 'admin' %>
      <p>
        <%= link_to "Edit", edit_student_path(student) %>
        |
        <%= button_to "Delete",
              student_path(student),
              method: :delete,
              form: { data: { turbo_confirm: "Are you sure you want to delete this student?" } } %>
      </p>
    <% end %>
</div>
